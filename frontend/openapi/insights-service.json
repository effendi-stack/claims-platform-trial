{
    "openapi": "3.1.0",
    "info": {
        "title": "OpenAPI definition",
        "version": "v0"
    },
    "servers": [
        {
            "url": "http://localhost:8082",
            "description": "Generated server url"
        }
    ],
    "paths": {
        "/api/insights/workload": {
            "get": {
                "tags": [
                    "Insights"
                ],
                "summary": "Open workload per handler, unassigned count, ageing and SLA breaches",
                "description": "Handlers always get their own team. Managers may pass teamId, or omit it for all teams.",
                "operationId": "workload",
                "parameters": [
                    {
                        "name": "teamId",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Workload"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/insights/throughput": {
            "get": {
                "tags": [
                    "Insights"
                ],
                "summary": "Decisions and average time to decision, per handler (default: last 30 days)",
                "operationId": "throughput",
                "parameters": [
                    {
                        "name": "teamId",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Throughput"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/insights/exposure": {
            "get": {
                "tags": [
                    "Insights"
                ],
                "summary": "Outstanding liability by market x line x currency, with USD totals and the largest open reserves",
                "operationId": "exposure",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Exposure"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
