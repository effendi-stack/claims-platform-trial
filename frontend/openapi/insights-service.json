                "properties": {
                    "days0to7": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "days8to30": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "over30": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "HandlerLoad": {
                "type": "object",
                "properties": {
                    "handlerId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "handlerName": {
                        "type": "string"
                    },
                    "open": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "inReview": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "awaitingInfo": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "slaBreached": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "oldestOpenDays": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "Workload": {
                "type": "object",
                "properties": {
                    "teamId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "openClaims": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "unassigned": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "slaBreached": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "ageing": {
                        "$ref": "#/components/schemas/Ageing"
                    },
                    "handlers": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/HandlerLoad"
                        }
                    },
                    "generatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "HandlerThroughput": {
                "type": "object",
                "properties": {
                    "handlerId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "handlerName": {
                        "type": "string"
                    },
                    "approved": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "rejected": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "avgDaysToDecision": {
                        "type": "number"
                    }
                }
            },
            "Throughput": {
                "type": "object",
                "properties": {
                    "teamId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "from": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "to": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "decided": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "approved": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "rejected": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "avgDaysToDecision": {
                        "type": "number"
                    },
                    "handlers": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/HandlerThroughput"
                        }
                    }
                }
            },
            "Exposure": {
                "type": "object",
                "properties": {
                    "segments": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Segment"
                        }
                    },
                    "totalOutstandingUsd": {
                        "type": "number"
                    },
                    "totalPaidUsd": {
                        "type": "number"
                    },
                    "largestOpenReserves": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/LargeClaim"
                        }
                    },
                    "fxNote": {
                        "type": "string"
                    },
                    "generatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "LargeClaim": {
                "type": "object",
                "properties": {
                    "claimId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "claimNumber": {
                        "type": "string"
                    },
                    "marketCode": {
                        "type": "string"
                    },
                    "productLine": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "currentReserve": {
                        "type": "number"
                    },
                    "reserveUsd": {
                        "type": "number"
                    }
                }
            },
            "Segment": {
                "type": "object",
                "properties": {
                    "marketCode": {
                        "type": "string"
                    },
                    "productLine": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "openClaims": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "outstandingReserve": {
                        "type": "number"
                    },
                    "paid": {
                        "type": "number"
                    },
                    "incurred": {
                        "type": "number"
                    },
                    "outstandingUsd": {
                        "type": "number"
                    }
                }
            }
        }
    }
}
