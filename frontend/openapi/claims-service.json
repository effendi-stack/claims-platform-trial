                                    "$ref": "#/components/schemas/ClaimDetail"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/claims/{id}/settle": {
            "post": {
                "tags": [
                    "Claims"
                ],
                "summary": "Record settlement payment of the approved amount",
                "operationId": "settle",
                "parameters": [
                    {
                        "name": "id",
