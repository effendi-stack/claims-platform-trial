                                        "$ref": "#/components/schemas/UserView"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "MotorDetails": {
                "type": "object",
                "properties": {
                    "vehicleRegistration": {
                        "type": "string",
                        "maxLength": 20,
                        "minLength": 0
                    },
                    "location": {
                        "type": "string",
                        "maxLength": 300,
                        "minLength": 0
                    },
                    "thirdPartyInvolved": {
                        "type": "boolean"
                    },
                    "injuries": {
                        "type": "boolean"
                    },
                    "policeReportNumber": {
                        "type": "string",
                        "maxLength": 50,
                        "minLength": 0
                    }
                },
                "required": [
                    "injuries",
                    "location",
                    "thirdPartyInvolved",
                    "vehicleRegistration"
                ]
            },
            "PropertyDetails": {
                "type": "object",
                "properties": {
                    "propertyAddress": {
                        "type": "string",
                        "maxLength": 300,
                        "minLength": 0
                    },
                    "peril": {
                        "type": "string",
                        "enum": [
                            "FIRE",
                            "FLOOD",
                            "STORM",
                            "THEFT",
                            "ESCAPE_OF_WATER",
                            "ACCIDENTAL_DAMAGE",
                            "OTHER"
                        ]
                    },
                    "habitable": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "habitable",
                    "peril",
                    "propertyAddress"
                ]
            },
            "SubmitClaim": {
                "type": "object",
                "properties": {
                    "policyId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "incidentDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 4000,
                        "minLength": 0
                    },
                    "claimedAmount": {
                        "type": "number"
                    },
                    "motor": {
                        "$ref": "#/components/schemas/MotorDetails"
                    },
                    "property": {
                        "$ref": "#/components/schemas/PropertyDetails"
                    }
                },
                "required": [
                    "claimedAmount",
                    "description",
                    "incidentDate",
                    "policyId"
                ]
            },
            "ClaimDetail": {
                "type": "object",
                "properties": {
                    "summary": {
                        "$ref": "#/components/schemas/ClaimSummary"
                    },
                    "version": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "policyId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "policyNumber": {
                        "type": "string"
                    },
                    "incidentDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "description": {
                        "type": "string"
                    },
                    "details": {
                        "type": "object",
                        "additionalProperties": {}
                    },
                    "timeline": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TimelineItem"
                        }
                    },
                    "informationRequests": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/InformationRequestItem"
                        }
                    },
                    "decision": {
                        "$ref": "#/components/schemas/DecisionItem"
                    },
                    "payments": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PaymentItem"
                        }
                    },
                    "allowedActions": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "PICK_UP",
                                "ASSIGN",
                                "REQUEST_INFO",
                                "RESPOND_TO_INFO",
                                "SET_RESERVE",
                                "APPROVE",
                                "REJECT",
                                "SETTLE",
                                "WITHDRAW"
                            ]
                        }
                    },
                    "reserveHistory": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ReserveItem"
                        }
                    }
                }
            },
            "ClaimSummary": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "claimNumber": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "SUBMITTED",
                            "IN_REVIEW",
                            "AWAITING_INFO",
                            "APPROVED",
                            "SETTLED",
                            "REJECTED",
                            "WITHDRAWN"
                        ]
                    },
                    "productLine": {
                        "type": "string",
                        "enum": [
                            "MOTOR",
                            "PROPERTY"
                        ]
                    },
                    "marketCode": {
                        "type": "string"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "claimedAmount": {
                        "type": "number"
                    },
                    "reportedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "assignedHandlerId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "assignedHandlerName": {
                        "type": "string"
                    },
                    "claimantName": {
                        "type": "string"
                    },
                    "teamId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "currentReserve": {
                        "type": "number"
                    },
                    "priority": {
                        "type": "string",
                        "enum": [
                            "HIGH",
                            "NORMAL",
                            "LOW"
                        ]
                    },
                    "slaDueAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "slaBreached": {
                        "type": "boolean"
                    }
                }
            },
            "DecisionItem": {
                "type": "object",
                "properties": {
                    "outcome": {
                        "type": "string"
                    },
                    "approvedAmount": {
                        "type": "number"
                    },
                    "reasonCode": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string"
                    },
                    "decidedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "InformationRequestItem": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "question": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "requestedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "dueAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "responseText": {
                        "type": "string"
                    },
                    "respondedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "PaymentItem": {
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "number"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "reference": {
                        "type": "string"
                    },
                    "paidAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "ReserveItem": {
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "number"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "reason": {
                        "type": "string"
                    },
                    "setByName": {
                        "type": "string"
                    },
                    "setAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "TimelineItem": {
                "type": "object",
                "properties": {
                    "fromStatus": {
                        "type": "string",
                        "enum": [
                            "SUBMITTED",
                            "IN_REVIEW",
                            "AWAITING_INFO",
                            "APPROVED",
                            "SETTLED",
                            "REJECTED",
                            "WITHDRAWN"
                        ]
                    },
                    "toStatus": {
                        "type": "string",
                        "enum": [
                            "SUBMITTED",
                            "IN_REVIEW",
                            "AWAITING_INFO",
