                                    "$ref": "#/components/schemas/ClaimDetail"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/claims/{id}/reject": {
            "post": {
                "tags": [
                    "Claims"
                ],
                "summary": "Reject with a reason code",
                "operationId": "reject",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Reject"
