                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ClaimDetail"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/claims/{id}/reserve": {
            "post": {
                "tags": [
                    "Claims"
                ],
                "summary": "Revise the reserve (estimated liability)",
                "operationId": "setReserve",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
