                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/claims/{id}/approve": {
            "post": {
                "tags": [
                    "Claims"
                ],
                "summary": "Approve for settlement (subject to the handler's authority limit)",
                "operationId": "approve",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
