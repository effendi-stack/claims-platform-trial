                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/HandlerView"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/events/stream": {
            "get": {
                "tags": [
                    "Notifications & live updates"
                ],
                "summary": "Live updates (Server-Sent Events)",
                "description": "EventSource cannot set headers, so this endpoint also accepts ?access_token=<jwt>.",
                "operationId": "stream",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "text/event-stream": {
                                "schema": {
