                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ClaimDetail"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/dev-login": {
            "post": {
                "tags": [
                    "Auth (dev only)"
                ],
                "summary": "Issue a token for a seeded demo user",
                "operationId": "login",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DevLoginRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/policies/mine": {
            "get": {
                "tags": [
                    "Reference data"
                ],
                "summary": "Policies held by the signed-in claimant (to report a claim against)",
                "operationId": "myPolicies",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/PolicyView"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/notifications": {
            "get": {
                "tags": [
                    "Notifications & live updates"
                ],
                "summary": "The caller's latest notifications",
                "operationId": "mine",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/NotificationView"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/handlers": {
            "get": {
                "tags": [
                    "Reference data"
                ],
                "summary": "Handlers in a team (for assignment). Handlers may only list their own team.",
                "operationId": "handlers",
                "parameters": [
                    {
                        "name": "teamId",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
