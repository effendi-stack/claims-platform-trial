                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/claims/{id}/information-requests": {
            "post": {
                "tags": [
                    "Claims"
                ],
                "summary": "Ask the claimant for more information (pauses the SLA)",
                "operationId": "requestInformation",
